---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% assign ext = page.path | split: '.' | last %}
    {% if ext == 'md' or ext == 'html' %}
    {% unless page.url contains '/assets/' or page.url contains '/404' or page.sitemap == false %}
    <url>
      <loc>{{ page.url | replace: 'index.html', '' | prepend: site.baseurl | prepend: site.url }}</loc>
      {% assign lm = page.last_modified_at | default: page.date %}
      {% if lm %}<lastmod>{{ lm | date_to_xmlschema }}</lastmod>{% endif %}
      <priority>{% if page.url == '/' %}1.0{% else %}0.8{% endif %}</priority>
    </url>
    {% endunless %}
    {% endif %}
  {% endfor %}

  {% assign entries = site.posts | concat: site.projects | concat: site.notes | concat: site.info %}
  {% for e in entries %}
    <url>
      <loc>{{ e.url | prepend: site.baseurl | prepend: site.url }}</loc>
      {% assign lm = e.last_modified_at | default: e.date %}
      {% if lm %}<lastmod>{{ lm | date_to_xmlschema }}</lastmod>{% endif %}
      <priority>{% if e.collection == 'posts' or e.collection == 'projects' %}0.7{% else %}0.6{% endif %}</priority>
    </url>
  {% endfor %}
</urlset>
